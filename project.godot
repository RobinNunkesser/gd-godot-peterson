; Engine configuration file.
; Peterson 3D Crash Simulator (Godot 4)
; Operating Systems Didactic Showcase: Mutual Exclusion & Race Conditions

config_version=5

[application]

config/name="Peterson 3D Crash Simulator"
config/description="Operating Systems Didactic Showcase: Visualizing Mutual Exclusion, Race Conditions and Peterson's Algorithm in 3D"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=0
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

environment/defaults/default_clear_color=Color(0.04, 0.05, 0.09, 1)
textures/vram_compression/import_etc2_astc=true
renderer/rendering_method.web="gl_compatibility"
